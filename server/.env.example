# Mingo Chat Server Environment Variables
PORT=5000

# Client origin (comma separated for multiple origins if needed)
# In production: https://mingo-chat-app-five.vercel.app
CLIENT_URL=http://localhost:5173

MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Mingo-ChatApp_DB?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
NODE_ENV=development

# Optional: Gmail SMTP Service
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
